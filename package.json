{
  "name": "up-run",
  "private": true,
  "version": "2.0.0",
  "description": "UP RUN: Political Rivalry Mode - a satirical Subway Surfers-style endless runner for mobile and desktop browsers.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node tests/e2e/run.cjs",
    "build:single": "tsc --noEmit && vite build --config vite.single.config.ts"
  },
  "dependencies": {
    "@fontsource/baloo-2": "5.3.0",
    "@fontsource/bangers": "5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "2.1.8"
  }
}
